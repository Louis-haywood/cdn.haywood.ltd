# A long random secret — the watcher must use the same value
API_KEY=replace-with-a-long-random-secret

# Your CDN subdomain
DOMAIN=cdn.haywood.ltd

# Leave CERT_PATH and KEY_PATH blank to run HTTP-only on PORT (useful for first-time testing)
# Fill them in after running win-acme (see SETUP.md Step 6)
CERT_PATH=C:\cdn-certs\cdn.haywood.ltd-crt.pem
KEY_PATH=C:\cdn-certs\cdn.haywood.ltd-key.pem

# Only used when CERT_PATH / KEY_PATH are blank (HTTP-only mode)
PORT=3000
